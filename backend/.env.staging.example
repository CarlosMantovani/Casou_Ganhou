SPRING_PROFILES_ACTIVE=staging

DATABASE_URL=jdbc:postgresql://replace-with-neon-host/wedding_raffle_staging?sslmode=require
DATABASE_USERNAME=replace_with_neon_username
DATABASE_PASSWORD=replace_with_neon_password

SPRING_FLYWAY_PLACEHOLDERS_ADMIN_USERNAME=admin
SPRING_FLYWAY_PLACEHOLDERS_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

FRONTEND_ORIGIN=https://replace-with-vercel-preview.vercel.app

JWT_SECRET=replace_with_a_strong_homologation_secret
JWT_EXPIRATION_SECONDS=3600
JWT_ISSUER=raffle-api-staging

RAFFLE_UNIT_PRICE=10.00
RAFFLE_NUMBER_MIN=00000
RAFFLE_NUMBER_MAX=99999

MERCADO_PAGO_ACCESS_TOKEN=replace_with_mercado_pago_test_access_token
MERCADO_PAGO_WEBHOOK_URL=https://replace-with-render-service.onrender.com/payments/webhook
MERCADO_PAGO_WEBHOOK_SECRET=replace_with_mercado_pago_webhook_secret
MERCADO_PAGO_SUCCESS_URL=https://replace-with-vercel-preview.vercel.app/payment-return/success
MERCADO_PAGO_FAILURE_URL=https://replace-with-vercel-preview.vercel.app/payment-return/failure
MERCADO_PAGO_PENDING_URL=https://replace-with-vercel-preview.vercel.app/payment-return/pending
MERCADO_PAGO_RETRY_MAX_ATTEMPTS=3
MERCADO_PAGO_RETRY_DELAY_MILLIS=500
MERCADO_PAGO_RETRY_MULTIPLIER=2

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=no-reply@example.com
